# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: used for contact delivery, media signing and the seed command.
SUPABASE_SERVICE_ROLE_KEY=
# Configure Cloudflare Turnstile before accepting production inquiries.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Generate a random secret, e.g. openssl rand -hex 32
RATE_LIMIT_SALT=
# Only for running the seed script; existing Supabase Auth user email.
ADMIN_EMAIL=
# Explicitly allow bundled read-only content preview without Supabase.
# Set false for your real deployment. Mutations never use preview data.
CONTENT_PREVIEW=true
